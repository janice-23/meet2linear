# Copy to .env at the repo root and fill in.

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Linear personal API key (free plan works): Linear → Settings → Security & Access → API keys
LINEAR_API_KEY=

# Team to create issues in. Find IDs with the server running:
#   curl http://localhost:7337/api/config/linear
LINEAR_TEAM_ID=

# Optional: use an existing label instead of auto-creating "from-meet"
# LINEAR_LABEL_ID=

# PORT=7337  (if you change this, also change it in extension/src/background.ts + manifest.json)
